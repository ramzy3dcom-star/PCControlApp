<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:background="#1E1E1E"
        android:gravity="center"
        android:padding="16dp"
        android:text="جاهز للتنفيذ"
        android:textColor="#4ADE80"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnOn"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="14dp"
        android:backgroundTint="#16A34A"
        android:text="ON — تشغيل الجهاز"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnOff"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="14dp"
        android:backgroundTint="#DC2626"
        android:text="OFF — إغلاق الجهاز"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnSteam"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:backgroundTint="#2563EB"
        android:text="تشغيل Steam"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

</LinearLayout>
